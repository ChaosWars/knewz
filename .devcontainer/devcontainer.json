// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"lldb-dap.executable-path": "/usr/lib/llvm-19/bin/lldb-dap",
				"cmake.deleteBuildDirOnCleanConfigure": true,
				"cmake.generator": "Ninja",
				"cmake.preferredGenerators": [
					"Ninja"
				]
			},
			"extensions": [
				"bierner.markdown-preview-github-styles",
				"GitHub.vscode-pull-request-github",
				"llvm-vs-code-extensions.lldb-dap",
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-azuretools.vscode-docker",
				"ms-vscode.cmake-tools",
				"ms-vscode.cpptools-extension-pack"
			]
		}
	},
	// "dockerComposeFile": "compose.yml",
	"containerEnv": {
		"LOCAL_WORKSPACE_DIR": "${containerWorkspaceFolder}"
	},
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// "image": "mcr.microsoft.com/devcontainers/base:noble",
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/ChaosWars/vscode-features/llvm:1": {},
		"ghcr.io/devcontainers-extra/features/apt-get-packages": {
			"packages": [
				"ccache",
				"jq",
				"kde-standard"
			]
		},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},
	"image": "mcr.microsoft.com/devcontainers/base:noble",
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	"name": "knewz",
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "",
	"postCreateCommand": ".devcontainer/postCreate.sh",
	// "service": "devcontainer",
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}
